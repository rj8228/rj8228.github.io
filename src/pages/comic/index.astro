---
// Homepage: comic-style sections with still poses; the painted train scene fills the hero.
import '../../styles/global.css';
import profile from '../../data/profile.json';
import poses from '../../../public/hero/poses.json';
import HeroScene from '../../components/motion/HeroScene';
import HeroTitle from '../../components/motion/HeroTitle';
import PoseEnter from '../../components/motion/PoseEnter';
import Reveal from '../../components/motion/Reveal';
import HeroIntro from '../../components/motion/HeroIntro';
import ReplayIntro from '../../components/motion/ReplayIntro';
import ScrollProgress from '../../components/motion/ScrollProgress';
import Spine from '../../components/motion/Spine';
import TiltCard from '../../components/motion/TiltCard';

const { name, role, tagline, location, cta, origin, powers, missions, personality, timeline, contact } = profile;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const img = (id: string) => `/hero/${id}.webp`;
// Every pose is drawn at the same scale (pixels of art per screen pixel), so the character is the
// same size in each section; a crouch is simply shorter than a stretch.
const POSE_SCALE = 0.17;
const pose = (id: keyof typeof poses, x: number) => ({
	id,
	src: img(id),
	x,
	h: Math.round(poses[id].h * POSE_SCALE),
});
// Every power, run together for the ticker under the hero.
const ticker = powers.flatMap((p) => p.items);
// Each mission's trailer and poster live under public/media/missions/, named after the title.
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const trailer = (title: string) => ({
	poster: `/media/missions/${slug(title)}.jpg`,
	video: `/media/missions/${slug(title)}.mp4`,
	alt: `Trailer for ${title}`,
});
// Timeline chapters: each study or work milestone opens a chapter; wins attach to the chapter they happened in.
type Entry = (typeof timeline)[number] & { where?: string };
const chapters: (Entry & { wins: Entry[] })[] = [];
for (const t of timeline as Entry[]) {
	if (t.kind === 'award') chapters.at(-1)?.wins.push(t);
	else chapters.push({ ...t, wins: [] });
}
const chapterLabel = { education: 'Study', work: 'Work' };
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${name} — ${tagline}`} />
		<title>{name}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&family=Space+Grotesk:wght@400;500;700&display=swap" />
		<!-- Motion islands render their pre-entrance state (hidden, offset); without JS, show everything in place. -->
		<script is:inline>
			// Decide before first paint whether the intro plays: once per visit, never with reduced motion or Save-Data.
			try {
				if (
					!sessionStorage.getItem('intro-seen') &&
					!matchMedia('(prefers-reduced-motion: reduce)').matches &&
					!navigator.connection?.saveData
				)
					document.documentElement.dataset.intro = 'play';
			} catch {}
		</script>
		<noscript><style>astro-island [style*='opacity'] { opacity: 1 !important; transform: none !important; }</style></noscript>
	</head>
	<body class="banner">
		<ScrollProgress client:load />
		<header class="hero">
			<div class="hero-banner" aria-hidden="true"><HeroScene client:load src={img('scene')} /></div>
			<HeroIntro client:load src="/media/hero/swing.mp4" poster="/media/hero/swing-end.jpg" />
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="sfx-small">ZZZIP!</p>
					<HeroTitle client:load text={name} />
					<p class="role">{role}</p>
					<p class="tagline">{tagline}</p>
					<p class="where">{location}</p>
					<div class="actions">
						<a class="btn primary" href={cta.href}>{cta.label}</a>
						<a class="btn ghost" href="#contact">Send a signal</a>
						<ReplayIntro client:idle />
					</div>
				</div>
				<figure class="hero-art">
					<div class="burst" aria-hidden="true"></div>
					<img src={img('wave')} alt={`Illustration of ${name} waving`} />
					<figcaption class="bubble">Hi! I build software for finance and AI.</figcaption>
				</figure>
			</div>
		</header>

		<div class="ticker-wrap" aria-hidden="true">
			<div class="ticker">
				<div class="ticker-track">
					{
						[0, 1].map(() =>
							ticker.map((t) => (
								<span class="ticker-item">
									{t}
									<svg viewBox="0 0 20 20"><polygon points="10,0 12.2,7 20,7 13.6,11.4 15.8,18.2 10,14 4.2,18.2 6.4,11.4 0,7 7.8,7" /></svg>
								</span>
							)),
						)
					}
				</div>
			</div>
		</div>

		<main>
			<section id="origin">
				<div class="section-head">
					<h2 class="sfx">Origin story</h2>
					<PoseEnter client:visible {...pose('crouch', 0.42)} />
				</div>
				<Reveal client:visible>
					<div class="panel origin">
						{origin.map((line) => <p>{line}</p>)}
					</div>
				</Reveal>
			</section>

			<section id="powers">
				<div class="section-head">
					<h2 class="sfx">Powers</h2>
					<PoseEnter client:visible {...pose('web-shot', 0.52)} />
				</div>
				<div class="grid">
					{
						powers.map((p, n) => (
							<Reveal client:visible delay={(n % 3) * 0.08} className="panel power">
								<h3>{p.name}</h3>
								<p>{p.items.map((i) => <span class="tag">{i}</span>)}</p>
							</Reveal>
						))
					}
				</div>
			</section>

			<section id="missions">
				<div class="section-head">
					<h2 class="sfx">Missions</h2>
					<PoseEnter client:visible {...pose('swing-low', 0.62)} />
				</div>
				<div class="grid">
					{
						missions.map((m, i) => (
							<TiltCard client:visible className="panel mission" media={trailer(m.title)}>
								<p class="mno">Mission {String(i + 1).padStart(2, '0')}</p>
								<h3>{m.title}</h3>
								<p>{m.summary}</p>
								<p>{m.stack.map((s) => <span class="tag">{s}</span>)}</p>
								{m.links.length > 0 && (
									<p class="mission-links">
										{m.links.map((l) => <a class="btn small" href={l.href} {...ext}>{l.label}</a>)}
									</p>
								)}
							</TiltCard>
						))
					}
				</div>
			</section>

			<section id="personality">
				<div class="section-head">
					<h2 class="sfx">Off duty</h2>
					<PoseEnter client:visible {...pose('flip', 0.72)} />
				</div>
				<div class="grid four">
					{
						personality.map((p, n) => {
							const [title, rest] = p.split(': ');
							return (
								<Reveal client:visible delay={n * 0.08} className="panel duty">
									<h3>{title}</h3>
									<p>{rest}</p>
								</Reveal>
							);
						})
					}
				</div>
			</section>

			<section id="timeline">
				<div class="section-head">
					<h2 class="sfx">Timeline</h2>
					<PoseEnter client:visible {...pose('land', 0.82)} />
				</div>
				<ol class="chapters">
					<Spine client:visible />
					{
						chapters.map((c, n) => (
							<li class={`chapter ${c.kind}`}>
								<Reveal client:visible from={n % 2 ? 'right' : 'left'} className="panel chapter-card">
									<p class="c-meta">
										<span class="c-kind">{chapterLabel[c.kind as keyof typeof chapterLabel]}</span>
										<span class="c-when">{c.when}</span>
									</p>
									<h3>{c.what}</h3>
									{c.where && <p class="c-where">{c.where}</p>}
									{c.wins.length > 0 && (
										<ul class="wins">
											{c.wins.map((w) => (
												<li>
													<span class="w-when">{w.when}</span>
													<span>{w.what}</span>
												</li>
											))}
										</ul>
									)}
								</Reveal>
							</li>
						))
					}
				</ol>
			</section>

			<section id="contact">
				<div class="section-head">
					<h2 class="sfx">Send a signal</h2>
					<PoseEnter client:visible {...pose('wave', 0.92)} />
				</div>
				<div class="contact">
					<Reveal client:visible className="panel signal">
						<p class="signal-line">Building something in finance, AI or learning? Let's talk.</p>
						<p class="links">
							{contact.email && <a class="btn primary" href={`mailto:${contact.email}`}>Email me</a>}
							{contact.github && <a class="btn small" href={contact.github} {...ext}>GitHub</a>}
							{contact.linkedin && <a class="btn small" href={contact.linkedin} {...ext}>LinkedIn</a>}
						</p>
					</Reveal>
				</div>
			</section>
		</main>

		<style is:global>
			h1,
			h2,
			h3,
			.sfx,
			.sfx-small,
			.mno {
				font-family: 'Bangers', Impact, system-ui, sans-serif;
				font-weight: 400;
				letter-spacing: 0.04em;
			}
			.sfx {
				font-size: clamp(2.5rem, 7vw, 4rem);
			}
			h3 {
				margin: 0 0 8px;
				font-size: 1.6rem;
			}

			/* Hero */
			.hero {
				position: relative;
				overflow: hidden;
				border-bottom: 4px solid var(--ink);
				background:
					radial-gradient(circle at 75% 55%, var(--night-2) 0 30%, transparent 60%),
					var(--night);
			}
			.hero-inner {
				position: relative;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				align-items: end;
				gap: 24px;
				max-width: 1040px;
				min-height: min(92vh, 820px);
				margin: 0 auto;
				padding: 48px 16px 0;
			}
			.hero-copy {
				align-self: center;
				padding-bottom: 48px;
			}
			.sfx-small {
				display: inline-block;
				margin: 0;
				font-size: 2rem;
				color: var(--accent);
				transform: rotate(-6deg);
				text-shadow: 3px 3px 0 var(--ink);
			}
			.hero h1 {
				margin: 4px 0 0;
				font-size: clamp(3.5rem, 11vw, 7.5rem);
				line-height: 0.9;
				color: var(--bone);
				text-shadow: 5px 5px 0 var(--accent), 9px 9px 0 var(--ink);
			}
			.role {
				margin: 20px 0 0;
				font-weight: 700;
				color: var(--accent);
			}
			.tagline {
				margin: 12px 0 0;
				max-width: 36ch;
				font-size: 1.25rem;
			}
			.where {
				margin: 8px 0 0;
				opacity: 0.7;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 24px;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				padding: 0 20px;
				border: var(--panel-border);
				border-radius: var(--radius);
				font-weight: 800;
				text-decoration: none;
			}
			.btn.primary {
				background: var(--accent);
				color: var(--ink);
				box-shadow: 4px 4px 0 var(--bone);
			}
			.btn.ghost {
				border-color: var(--bone);
				color: var(--bone);
			}
			.panel .btn.small,
			.btn.small {
				min-height: 40px;
				padding: 0 14px;
				background: var(--ink);
				color: var(--bone);
			}
			.panel .btn.primary {
				color: var(--ink);
				box-shadow: 4px 4px 0 var(--ink);
			}
			.hero-art {
				position: relative;
				margin: 0;
				align-self: end;
				justify-self: center;
			}
			.hero-art img {
				position: relative;
				display: block;
				height: min(78vh, 700px);
				width: auto;
			}
			.burst {
				position: absolute;
				left: 50%;
				top: 18%;
				width: 120%;
				aspect-ratio: 1;
				transform: translateX(-50%);
				border-radius: 50%;
				background: radial-gradient(var(--accent) 1.6px, transparent 2px) 0 0 / 12px 12px;
				mask-image: radial-gradient(circle, #000 25%, transparent 70%);
				opacity: 0.55;
			}
			.bubble {
				position: absolute;
				right: 72%;
				top: 6%;
				width: 200px;
				padding: 12px 16px;
				background: var(--bone);
				color: var(--ink);
				border: var(--panel-border);
				border-radius: 18px;
				font-weight: 700;
				line-height: 1.3;
			}
			.bubble::after {
				content: '';
				position: absolute;
				right: -18px;
				top: 28px;
				border: 10px solid transparent;
				border-left: 16px solid var(--ink);
			}

			/* Banner variant: the painted train scene fills the hero */
			.hero-banner {
				display: none;
			}
			.banner .hero-banner {
				display: block;
				position: absolute;
				inset: 0 42% 0 0;
			}
			.banner .hero-banner img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 48% 30%;
				mask-image: linear-gradient(90deg, #000 55%, transparent 98%);
			}
			.banner .hero-banner::after {
				content: '';
				position: absolute;
				inset: 0;
				background: none;
			}
			.banner .hero-inner {
				grid-template-columns: 1fr 1fr;
			}
			.banner .hero-copy {
				grid-column: 2;
			}
			.banner .hero-art {
				display: none;
			}

			/* Sections */
			.origin p {
				font-size: 1.1rem;
			}
			.origin p:first-child::first-letter {
				float: left;
				margin: 4px 8px 0 0;
				font: 3.4rem/0.8 'Bangers', Impact, sans-serif;
				color: var(--accent);
				-webkit-text-stroke: 1px var(--ink);
			}
			.section-head {
				position: relative;
			}
			/* One pose per section tells the story down the page (crouch, web, swing, flip, land, wave),
			   drifting left to right; the bottom 35% of each pose overlaps the section's first panel. */
			.head-pose {
				position: absolute;
				z-index: 1;
				left: calc(var(--x) * 100%);
				bottom: -46px;
				transform: translateX(-50%);
			}
			.head-pose img {
				display: block;
				height: var(--h);
				width: auto;
				cursor: grab;
			}
			/* Room under the overlapping pose so it never covers text. */
			.section-head + astro-island .panel,
			.section-head + .contact .panel,
			.section-head + .grid > :nth-child(-n + 4) .panel {
				padding-top: 64px;
			}
			.mno {
				margin: 0;
				font-size: 1rem;
				color: #9a5b00;
			}
			.mission {
				display: flex;
				flex-direction: column;
			}
			.mission-links {
				display: flex;
				gap: 10px;
				margin-top: auto;
			}
			.four {
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			}
			.duty p {
				margin: 0;
			}
			/* Timeline: chapters alternate either side of a centre spine, like panels on a comic page. */
			.chapters {
				position: relative;
				display: grid;
				gap: 28px;
				margin: 0;
				padding: 8px 0;
				list-style: none;
			}
			.spine {
				position: absolute;
				left: 50%;
				top: 0;
				bottom: 0;
				width: 6px;
				transform: translateX(-50%);
				background: repeating-linear-gradient(rgba(244, 239, 228, 0.15) 0 14px, transparent 14px 22px);
			}
			/* The saffron dashes fill in over the faint track as the reader scrolls. */
			.spine-fill {
				height: 100%;
				transform-origin: top;
				background: repeating-linear-gradient(var(--accent) 0 14px, transparent 14px 22px);
			}
			.chapter {
				position: relative;
				width: calc(50% - 40px);
			}
			.chapter:nth-of-type(even) {
				margin-left: calc(50% + 40px);
			}
			/* Stagger: each chapter starts before the one opposite it ends. */
			.chapter + .chapter {
				margin-top: -64px;
			}
			/* Each chapter's node on the spine, joined to its card by a short arm. */
			.chapter::before,
			.chapter::after {
				content: '';
				position: absolute;
				top: 30px;
			}
			.chapter::before {
				right: -40px;
				width: 40px;
				border-top: 3px solid var(--bone);
			}
			.chapter::after {
				right: -51px;
				top: 20px;
				width: 22px;
				height: 22px;
				border: 3px solid var(--ink);
				border-radius: 50%;
				background: var(--accent);
			}
			.chapter:nth-of-type(even)::before {
				right: auto;
				left: -40px;
			}
			.chapter:nth-of-type(even)::after {
				right: auto;
				left: -51px;
			}
			.chapter.education::after {
				background: #6fa8dc;
			}
			.chapter-card {
				padding: 20px 22px;
			}
			.chapter.education .chapter-card {
				box-shadow: 6px 6px 0 #6fa8dc;
			}
			.c-meta {
				display: flex;
				align-items: center;
				gap: 10px;
				margin: 0 0 6px;
			}
			.c-kind {
				padding: 1px 8px;
				border: 2px solid var(--ink);
				border-radius: 4px;
				font-size: 0.7rem;
				font-weight: 800;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				background: var(--accent);
			}
			.education .c-kind {
				background: #cfe0f2;
			}
			.c-when {
				font: 1.5rem/1 'Bangers', Impact, sans-serif;
				letter-spacing: 0.04em;
			}
			.chapter-card h3 {
				margin: 0;
				font-family: system-ui, sans-serif;
				font-size: 1.05rem;
				font-weight: 800;
				letter-spacing: 0;
			}
			.c-where {
				margin: 4px 0 0;
				color: #4a4f66;
			}
			.wins {
				display: grid;
				gap: 10px;
				margin: 16px 0 0;
				padding: 14px 0 0;
				border-top: 2px dashed var(--ink);
				list-style: none;
			}
			.wins li {
				position: relative;
				display: grid;
				grid-template-columns: 82px 1fr;
				gap: 8px;
				padding-left: 30px;
				font-size: 0.92rem;
				line-height: 1.4;
			}
			/* Comic star burst marking each win. */
			.wins li::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0;
				width: 20px;
				height: 20px;
				background: var(--accent);
				clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
			}
			.w-when {
				font-weight: 800;
			}
			.contact {
				display: flex;
				align-items: end;
				gap: 24px;
			}
			.signal {
				flex: 1;
				align-self: center;
			}
			.signal-line {
				margin-top: 0;
				font-size: 1.2rem;
				font-weight: 700;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin: 0;
			}

			body {
				font-family: 'Space Grotesk', system-ui, sans-serif;
			}
			:focus-visible {
				outline: 3px solid var(--accent);
				outline-offset: 3px;
			}

			/* Motion layer */
			/* Cards that slide in from the side start offscreen; never let them scroll the page sideways. */
			main {
				overflow-x: clip;
			}
			.scroll-progress {
				position: fixed;
				inset: 0 0 auto;
				z-index: 10;
				height: 5px;
				transform-origin: left;
				background: var(--accent);
				box-shadow: 0 2px 0 var(--ink);
			}
			.hero h1 .word {
				display: inline-block;
				white-space: nowrap;
				margin-right: 0.22em;
			}
			.hero h1 .letter {
				display: inline-block;
			}
			/* The rest of the hero copy lands just after the name finishes popping in. */
			.hero-copy > :not(h1, astro-island) {
				animation: drop-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
			}
			.hero-copy > .sfx-small {
				animation-name: sfx-pop;
			}
			.hero-copy > .role {
				animation-delay: 0.7s;
			}
			.hero-copy > .tagline {
				animation-delay: 0.8s;
			}
			.hero-copy > .where {
				animation-delay: 0.9s;
			}
			.hero-copy > .actions {
				animation-delay: 1s;
			}
			@keyframes drop-in {
				from {
					opacity: 0;
					transform: translateY(18px);
				}
			}
			@keyframes sfx-pop {
				from {
					opacity: 0;
					transform: rotate(-30deg) scale(0.2);
				}
			}
			.btn {
				cursor: pointer;
				transition:
					transform 0.15s,
					box-shadow 0.15s;
			}
			.btn:hover {
				transform: translate(-2px, -2px);
			}
			.btn:active {
				transform: translate(3px, 3px);
				box-shadow: none;
			}
			/* Skills ticker between the hero and the story. */
			/* Clips the tilted ticker's corners so they never scroll the page sideways. */
			.ticker-wrap {
				overflow: hidden;
				margin-top: -10px;
				padding-bottom: 14px;
			}
			.ticker {
				border-bottom: 4px solid var(--ink);
				background: var(--accent);
				color: var(--ink);
				transform: rotate(-1.2deg) scale(1.02);
				box-shadow: 0 6px 0 var(--ink);
			}
			.ticker-track {
				display: flex;
				width: max-content;
				animation: ticker 60s linear infinite;
			}
			.ticker:hover .ticker-track {
				animation-play-state: paused;
			}
			.ticker-item {
				display: inline-flex;
				align-items: center;
				gap: 18px;
				padding: 10px 0 10px 18px;
				font: 1.4rem/1 'Bangers', Impact, sans-serif;
				letter-spacing: 0.06em;
				white-space: nowrap;
			}
			.ticker-item svg {
				width: 16px;
				height: 16px;
				fill: var(--ink);
			}
			@keyframes ticker {
				to {
					transform: translateX(-50%);
				}
			}
			/* Section titles slam in as they scroll into view, where the browser supports view timelines. */
			@supports (animation-timeline: view()) {
				.section-head .sfx {
					animation: sfx-slam linear both;
					animation-timeline: view();
					animation-range: entry 10% cover 30%;
				}
			}
			@keyframes sfx-slam {
				from {
					opacity: 0;
					transform: rotate(-12deg) scale(1.8);
				}
				to {
					opacity: 1;
					transform: rotate(-2deg) scale(1);
				}
			}
			.mission {
				position: relative;
				overflow: hidden;
				transform-style: preserve-3d;
			}
			.spotlight {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			/* Intro video: covers the hero until it ends or is skipped; the hero copy holds its entrance meanwhile. */
			.intro {
				position: absolute;
				inset: 0;
				z-index: 5;
				display: grid;
				place-items: center;
				background: var(--night);
			}
			.intro video {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.intro-skip {
				position: absolute;
				right: 16px;
				bottom: 24px;
				background: rgba(11, 21, 48, 0.75);
				border-color: var(--bone);
				color: var(--bone);
			}
			html[data-intro='play'] .hero-copy > * {
				animation-play-state: paused;
			}
			html[data-intro='play'] .scroll-progress {
				opacity: 0;
			}
			.replay {
				gap: 8px;
				background: none;
				font: inherit;
				font-weight: 800;
			}
			.replay svg {
				width: 16px;
				height: 16px;
				fill: currentColor;
			}
			/* Mission trailer sits at the top of the card as a framed comic panel. */
			.mission-media {
				margin: -8px 0 16px;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				border: var(--panel-border);
				border-radius: 4px;
				background: var(--night);
			}
			.mission-media video {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			@media (prefers-reduced-motion: reduce) {
				.hero-copy > *,
				.ticker-track,
				.section-head .sfx {
					animation: none !important;
				}
			}

			@media (max-width: 760px) {
				/* Portrait screens: show the whole widescreen intro rather than a cropped slice. */
				.intro video {
					object-fit: contain;
				}
				.hero-inner,
				.banner .hero-inner {
					grid-template-columns: 1fr;
					padding-top: 32px;
				}
				.banner .hero-banner {
					inset: 0 0 45% 0;
				}
				.banner .hero-copy {
					grid-column: 1;
					padding-top: 46vh;
				}
				.banner .hero-banner::after {
					background: linear-gradient(transparent 60%, var(--night) 100%);
				}
				.hero-copy {
					padding-bottom: 0;
				}
				.hero-art img {
					height: 52vh;
				}
				.bubble {
					right: auto;
					left: 55%;
					width: 150px;
					font-size: 0.85rem;
				}
				.bubble::after {
					display: none;
				}
				.head-pose {
					left: auto;
					right: 0;
					bottom: -28px;
					transform: none;
				}
				.head-pose img {
					height: calc(var(--h) * 0.6);
				}
				.spine {
					left: 11px;
				}
				.chapter,
				.chapter:nth-of-type(even) {
					width: auto;
					margin-left: 40px;
				}
				.chapter + .chapter {
					margin-top: 0;
				}
				.chapter::before,
				.chapter:nth-of-type(even)::before {
					display: none;
				}
				.chapter::after,
				.chapter:nth-of-type(even)::after {
					left: -40px;
					right: auto;
				}
				.wins li {
					grid-template-columns: 1fr;
					gap: 0;
				}
			}
		</style>
	</body>
</html>
