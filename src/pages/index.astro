---
// Homepage: a calm portfolio with a "See inside" switch. On, every section shows its internals
// (architecture, decisions, bugs, numbers). Content lives in src/data/xray.ts; empty fields are hidden.
import { site, projects, showNext, next, timeline, skills, beyond } from '../data/xray';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
const { contact } = site;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${site.name}: ${site.headline} ${site.headlineAccent}. ${site.intro}`} />
		<title>{site.name} · Software engineer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&display=swap"
		/>
		<script is:inline>
			// Restore the switch before first paint: ?xray=1 in the URL wins, then the viewer's last choice.
			(() => {
				let on = new URLSearchParams(location.search).get('xray');
				if (on === null) {
					try { on = localStorage.getItem('xray'); } catch {}
				}
				if (on === '1') document.documentElement.dataset.xray = 'on';
			})();
		</script>
	</head>
	<body>
		<header class="bar">
			<div class="wrap bar-in">
				<a class="brand" href="/">{site.name}</a>
				<nav>
					<a href="#work">Work</a>
					<a href="#journey">Journey</a>
					<a href="#skills">Skills</a>
					<a href="#beyond">Beyond work</a>
					<button type="button" class="switch" id="xray" aria-pressed="false">
						<span class="track"><span class="knob"></span></span>
						<span class="off">See inside</span><span class="on">X-ray on</span>
					</button>
				</nav>
			</div>
		</header>

		<main class="wrap">
			<section class="hero">
				<div class="mono kicker"><span class="off">{site.kicker}</span><span class="on">{site.kickerOn}</span></div>
				<h1>{site.headline} <span class="accent">{site.headlineAccent}</span>.</h1>
				<p class="lede">{site.intro}</p>
				<div class="ctas">
					<a class="btn solid" href="#work">See the work</a>
					{contact.cv && <a class="btn line" href={contact.cv} {...ext}>No time? Get my CV (PDF)</a>}
					<span class="quick mono"><a href={contact.linkedin} {...ext}>LinkedIn</a> · <a href={contact.github} {...ext}>GitHub</a> · <a href={contact.credly} {...ext}>Credly</a></span>
				</div>
			</section>

			<section id="work">
				<div class="head">
					<h2>Things I've built</h2>
					<span class="mono hint"><span class="off">flip "See inside" to open any project up</span><span class="on">architecture · decisions · bugs · numbers</span></span>
				</div>
				<div class="grid work">
					{projects.map((p) => (
						<article class="card project">
							<div class="off stack">
								{p.image ? (
									<img class="shot" src={p.image} alt={`${p.name} screenshot`} loading="lazy" width="960" height="600" />
								) : (
									<div class="shot blank mono">{p.flow.join(' → ')}</div>
								)}
								<div class="mono small muted">{p.badge}</div>
								<h3>{p.name}</h3>
								<p>{p.line}</p>
								<div class="mono small muted push">{p.tags}</div>
								{p.links.length > 0 && (
									<div class="links">{p.links.map((l) => <a href={l.href} {...ext}>{l.label}</a>)}</div>
								)}
							</div>
							<div class="on stack">
								<div class="mono amber small">{p.name} · inside</div>
								<div class="flow mono">
									{p.flow.map((f, i) => (
										<>
											<span class="node">{f}</span>
											{i < p.flow.length - 1 && <span class="arrow">→</span>}
										</>
									))}
								</div>
								<dl class="facts mono">
									{p.why && <div><dt>why it exists</dt><dd>{p.why}</dd></div>}
									{p.decision && <div><dt>key decision</dt><dd>{p.decision}</dd></div>}
									{p.bug && <div><dt>hardest bug</dt><dd>{p.bug}</dd></div>}
									{p.numbers && <div><dt>numbers</dt><dd>{p.numbers}</dd></div>}
								</dl>
								{p.talk && (
									<div class="ask push"><span class="mono amber small">ASK ME ABOUT</span><br />{p.talk}</div>
								)}
								{p.links.length > 0 && (
									<div class="links">{p.links.map((l) => <a href={l.href} {...ext}>{l.label}</a>)}</div>
								)}
							</div>
						</article>
					))}
				</div>
				{showNext && <div class="grid next">
					{next.map((n) => (
						<div class="soon">
							<span class="mono accent tiny">IN THE WORKSHOP</span>
							<strong>{n.name}</strong>
							<span class="muted">{n.line}</span>
						</div>
					))}
				</div>}
			</section>

			<section id="journey">
				<div class="head">
					<h2>Journey</h2>
					<div class="head-end">
						<span class="mono hint on">the stories behind each line</span>
						<button type="button" class="more-btn mono" id="journey-more" aria-expanded="false" aria-controls="journey-list">Show details</button>
					</div>
				</div>
				<ol class="timeline" id="journey-list">
					{timeline.map((t) => (
						<li>
							<div class="mono when">{t.when}</div>
							<div class="stack">
								<div class="t-title">{t.title}</div>
								<div class="muted">{t.org}</div>
								{(t.body || t.highlights.length > 0 || t.marks.length > 0 || t.links.length > 0) && (
									<div class="more stack">
										{t.links.map((l) => <a class="t-link" href={l.href} {...ext}>{l.label}</a>)}
										{t.body && <p>{t.body}</p>}
										{t.highlights.length > 0 && (
											<ul class="wins">{t.highlights.map((h) => <li>{h}</li>)}</ul>
										)}
										{t.marks.length > 0 && (
											<div class="chips">
												{t.marks.map((m) => (
													<span class="pill"><span class="mono accent">{m.y}</span> {m.t}</span>
												))}
											</div>
										)}
									</div>
								)}
								{t.inside && <div class="x box">{t.inside}</div>}
							</div>
						</li>
					))}
				</ol>
			</section>

			<section id="skills">
				<div class="head">
					<h2>Skills</h2>
					<span class="mono hint"><span class="off">grouped by where I use them</span><span class="on">every skill points to where it was proven</span></span>
				</div>
				<div class="grid skills">
					{skills.map((g) => (
						<div class="card stack">
							<div class="g-name">{g.name}</div>
							<div class="chips">{g.chips.map((c) => <span class="chip mono">{c}</span>)}</div>
							{g.proof && <div class="x note"><span class="dim">proven in</span> · {g.proof}</div>}
						</div>
					))}
				</div>
			</section>

			<section id="beyond">
				<div class="head">
					<h2>Beyond work</h2>
					<span class="mono hint"><span class="off">what I do when nobody is paying me</span><span class="on">how each interest shows up at work</span></span>
				</div>
				<div class="grid beyond">
					{beyond.map((b) => (
						<div class="card stack">
							<div class="mono accent small">{b.tag}</div>
							<div class="b-title">{b.title}</div>
							<p class="muted">{b.body}</p>
							{b.inside && <div class="x note push"><span class="dim">shows up at work as</span> · {b.inside}</div>}
						</div>
					))}
				</div>
			</section>

			<footer id="contact">
				<span class="muted">{site.location}</span>
				<div class="links">
					{contact.cv && <a href={contact.cv} {...ext}>CV (PDF)</a>}
					<a href={contact.linkedin} {...ext}>LinkedIn</a>
					<a href={contact.github} {...ext}>GitHub</a>
					<a href={contact.credly} {...ext}>Credly</a>
					<a href={`mailto:${contact.email}`}>Email</a>
					<a href="/comic/" class="muted">Comic version</a>
				</div>
			</footer>
		</main>

		<script>
			const root = document.documentElement;
			const btn = document.getElementById('xray')!;
			const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.xray === 'on'));
			sync();
			btn.onclick = () => {
				const on = root.dataset.xray !== 'on';
				if (on) root.dataset.xray = 'on';
				else delete root.dataset.xray;
				try {
					localStorage.setItem('xray', on ? '1' : '0');
				} catch {}
				sync();
			};

			// Journey starts folded to titles; the button opens the CV-level detail.
			// onclick (not addEventListener) so a re-run script replaces the handler instead of stacking a second one.
			const more = document.getElementById('journey-more')!;
			const list = document.getElementById('journey-list')!;
			const setOpen = (open: boolean) => {
				list.classList.toggle('open', open);
				more.setAttribute('aria-expanded', String(open));
				more.textContent = open ? 'Hide details' : 'Show details';
			};
			setOpen(false);
			more.onclick = () => setOpen(!list.classList.contains('open'));
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f6f3ec;
		--ink: #1a1c22;
		--muted: #5e5a52;
		--accent: #b4531f;
		--line: #d9d3c6;
		--card: #fbf9f4;
		--btn: #ffffff;
		--btn-ink: #1a1c22;
		--track: #d9d3c6;
		--knob: #ffffff;
		--wire: #5b8bd9;
		--amber: #f2b661;
		--dim: #6e83a6;
		--blue-ink: #dce6f7;
		color-scheme: light;
	}
	:root[data-xray='on'] {
		--bg: #0e1626;
		--ink: #dce6f7;
		--muted: #9fb4d6;
		--accent: #f2b661;
		--line: #2b3d5c;
		--card: #121c2f;
		--btn: #1a2740;
		--btn-ink: #f2b661;
		--track: #f2b661;
		--knob: #0e1626;
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 80px;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: 'Bricolage Grotesque', system-ui, sans-serif;
		transition: background-color 0.35s, color 0.35s;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		body,
		.knob {
			transition: none !important;
		}
	}
	a {
		color: var(--accent);
	}
	img {
		max-width: 100%;
		display: block;
	}
	/* The switch: .on shows only in X-ray mode, .off only outside it; .x is extra detail that only X-ray reveals. */
	:root:not([data-xray='on']) .on,
	:root:not([data-xray='on']) .x,
	:root[data-xray='on'] .off {
		display: none !important;
	}
</style>

<style>
	.wrap {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 24px;
	}
	.mono {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
	}
	.muted {
		color: var(--muted);
	}
	.accent {
		color: var(--accent);
	}
	.amber {
		color: var(--amber);
	}
	.dim {
		color: var(--dim);
	}
	.small {
		font-size: 12px;
	}
	.tiny {
		font-size: 11px;
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 12px;
		flex: 1;
	}
	.push {
		margin-top: auto;
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 2;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		transition: background-color 0.35s;
	}
	.bar-in {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 12px;
		padding-bottom: 12px;
	}
	.brand {
		font-weight: 700;
		font-size: 18px;
		color: var(--ink);
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 18px;
		align-items: center;
		flex-wrap: wrap;
		font-size: 15px;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
	}
	.switch {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 16px;
		border: 1px solid var(--line);
		background: var(--btn);
		color: var(--btn-ink);
		font-family: 'IBM Plex Mono', monospace;
		font-size: 13px;
		border-radius: 999px;
		cursor: pointer;
	}
	.switch:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.track {
		width: 34px;
		height: 18px;
		border-radius: 999px;
		background: var(--track);
		position: relative;
		display: inline-block;
	}
	.knob {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--knob);
		transition: left 0.2s;
	}
	:global(:root[data-xray='on']) .knob {
		left: 18px;
	}

	.hero {
		padding: 88px 0 48px;
	}
	.kicker {
		font-size: 13px;
		color: var(--accent);
		margin-bottom: 18px;
	}
	h1 {
		margin: 0;
		font-size: clamp(44px, 8vw, 92px);
		line-height: 0.98;
		letter-spacing: -0.03em;
		font-weight: 600;
		max-width: 1000px;
		border: 1px dashed transparent;
	}
	:global(:root[data-xray='on']) h1 {
		border-color: var(--wire);
		padding: 20px;
	}
	.lede {
		margin: 28px 0 0;
		max-width: 680px;
		font-size: clamp(17px, 2vw, 20px);
		line-height: 1.55;
		color: var(--muted);
	}
	.ctas {
		display: flex;
		gap: 12px;
		margin-top: 32px;
		flex-wrap: wrap;
	}
	.btn {
		padding: 14px 20px;
		text-decoration: none;
		border-radius: 999px;
	}
	.btn.solid {
		background: var(--ink);
		color: var(--bg);
		font-weight: 600;
	}
	.quick {
		align-self: center;
		font-size: 13px;
		color: var(--muted);
	}
	.btn.line {
		border: 1px solid var(--ink);
		color: var(--ink);
	}

	.note {
		margin-top: 8px;
		border-top: 1px dashed var(--wire);
		padding-top: 10px;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 12px;
		line-height: 1.7;
		color: var(--amber);
	}
	.box {
		margin-top: 8px;
		border: 1px dashed var(--wire);
		padding: 14px;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 13px;
		line-height: 1.7;
		color: var(--amber);
		max-width: 760px;
	}

	section[id] {
		padding-top: 96px;
	}
	.head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: 24px;
	}
	h2 {
		margin: 0;
		font-size: clamp(30px, 4vw, 40px);
		font-weight: 600;
	}
	.hint {
		font-size: 13px;
		color: var(--muted);
	}

	.grid {
		display: grid;
		gap: 16px;
	}
	.grid.work {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
		gap: 20px;
	}
	.grid.next {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 12px;
		margin-top: 20px;
	}
	.grid.skills {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
	}
	.grid.beyond {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
	}
	.card {
		border: 1px solid var(--line);
		background: var(--card);
		border-radius: 16px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.project {
		padding: 24px;
		min-height: 460px;
	}
	.shot {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top left;
		border-radius: 10px;
		border: 1px solid var(--line);
	}
	.shot.blank {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 16px;
		background: #e6e0d2;
		color: #4a4740;
		font-size: 13px;
	}
	h3 {
		margin: 0;
		font-size: 26px;
		font-weight: 600;
	}
	.project p {
		margin: 0;
		font-size: 16px;
		line-height: 1.5;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		font-size: 15px;
	}
	.flow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		color: var(--blue-ink);
	}
	.node {
		border: 1px solid var(--wire);
		padding: 8px 10px;
	}
	.arrow {
		color: var(--wire);
	}
	.facts {
		margin: 0;
		font-size: 13px;
		line-height: 1.7;
		color: var(--muted);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.facts dt {
		display: inline;
		color: var(--dim);
	}
	.facts dt::after {
		content: ' · ';
	}
	.facts dd {
		display: inline;
		margin: 0;
	}
	.ask {
		border: 1px solid var(--amber);
		padding: 12px;
		font-size: 14px;
		line-height: 1.5;
	}
	.soon {
		border: 1px dashed var(--line);
		border-radius: 12px;
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 14px;
		line-height: 1.45;
	}
	.soon strong {
		font-size: 18px;
		font-weight: 600;
	}

	.head-end {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}
	.more-btn {
		min-height: 40px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--btn);
		color: var(--btn-ink);
		font-size: 13px;
		cursor: pointer;
	}
	.more-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.timeline:not(.open) .more {
		display: none;
	}
	.t-link {
		font-size: 15px;
		line-height: 1.5;
		max-width: 760px;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.timeline > li {
		display: grid;
		grid-template-columns: 170px minmax(0, 1fr);
		gap: 28px;
		padding: 26px 0;
		border-top: 1px solid var(--line);
	}
	.when {
		font-size: 13px;
		color: var(--muted);
		padding-top: 6px;
	}
	.t-title {
		font-size: 22px;
		font-weight: 600;
	}
	.timeline p {
		margin: 4px 0 0;
		font-size: 16px;
		line-height: 1.55;
		max-width: 760px;
	}
	.wins {
		margin: 4px 0 0;
		padding-left: 18px;
		max-width: 760px;
		font-size: 15px;
		line-height: 1.55;
		color: var(--muted);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.wins li::marker {
		color: var(--accent);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.pill {
		border: 1px solid var(--line);
		background: var(--card);
		padding: 8px 12px;
		border-radius: 999px;
		font-size: 13px;
	}
	.chip {
		border: 1px solid var(--line);
		padding: 6px 10px;
		border-radius: 8px;
		font-size: 13px;
	}
	.g-name {
		font-weight: 600;
